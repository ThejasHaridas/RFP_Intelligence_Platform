# --- LLM ---------------------------------------------------------------------
LLM=open                          # open = OpenRouter | gpt = OpenAI GPT (overrides LLM_PROVIDER)
OPENROUTER_API_KEY=               # from openrouter.ai/keys
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free   # any OpenRouter model id (":free" = no cost)
OPENAI_API_KEY=                   # from platform.openai.com/api-keys (for LLM=gpt)
OPENAI_MODEL=gpt-4o-mini          # GPT model used when LLM=gpt
# LLM_PROVIDER=nvidia             # other providers: nvidia | anthropic | ollama (used when LLM is unset)
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_EFFORT=low                  # Anthropic effort: low | medium | high
# LLM_BASE_URL=http://localhost:11434/v1   # for ollama / vLLM
# LLM_TEMPERATURE=                # default: 0 for GPT, 1.0 for OpenRouter/NVIDIA
LLM_THINKING=true                 # model reasoning on/off (OpenRouter / NVIDIA)
LLM_TOP_P=0.95
LLM_SEED=42
LLM_MAX_TOKENS=16384
LLM_CONCURRENCY=2                 # free OpenRouter models are rate-limited (~20 req/min)
LLM_TIMEOUT_S=300                 # reasoning models can take 60-120s per call
LLM_MAX_RETRIES=5                 # free endpoints have transient 502s / connection drops
LLM_CACHE=true                    # cache identical LLM calls on disk (.cache/llm)
LLM_REFUSAL_FALLBACK=true         # Anthropic server-side refusal fallback

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | openai | spacy | hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_BACKEND=cross-encoder            # cross-encoder | llm | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
QUERY_EXPANSION=true
OCR_ENABLED=true

# --- Paths / agents ------------------------------------------------------------
RFP_INDEX_DIR=./.index
RFP_OUTPUT_DIR=./outputs
MAX_FIELD_RETRIES=2
EVIDENCE_PER_FIELD=6
